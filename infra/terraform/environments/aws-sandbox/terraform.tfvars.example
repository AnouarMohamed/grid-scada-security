aws_region         = "us-east-1"
availability_zones = ["us-east-1a", "us-east-1b"]

# Phase 1: keep all billable runtime resources disabled.
enable_runtime       = false
enable_vpc_endpoints = false
enable_nat_gateway   = false

# Phase 2: push ECR images, create empty secret containers, and enable runtime.
# enable_runtime       = true
# enable_vpc_endpoints = true
# desired_counts = {
#   power_sim       = 0
#   modbus_ingestor = 0
#   influxdb        = 0
#   grafana         = 0
# }
# image_tags = {
#   power_sim       = "0.1.0"
#   modbus_ingestor = "0.1.0"
#   influxdb        = "2.9.1"
#   grafana         = "12.4.10"
# }

grafana_public = false
operator_cidrs = ["10.40.0.0/16"]

# Output of the owner-created foundation deployment bootstrap.
workload_role_permissions_boundary_arn = "arn:aws:iam::123456789012:policy/gridguard/gridguard-aws-sandbox-workload-boundary"

# OIDC is bootstrapped with an existing administrative identity. Prefer an
# existing account-wide provider and an account-managed least-privilege policy.
enable_github_oidc_role     = false
create_github_oidc_provider = false
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
# github_deploy_policy_arn = "arn:aws:iam::123456789012:policy/gridguard-terraform-deploy"
